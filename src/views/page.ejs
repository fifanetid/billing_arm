<%
const fmt=n=>'Rp '+Number(n||0).toLocaleString('id-ID');
const val=(obj,key)=>obj&&obj[key]!==undefined&&obj[key]!==null?obj[key]:'';
%>
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · FF Billing</title><link rel="stylesheet" href="/app.css"></head><body>
<% if(page==='login'){ %>
<main class="login-shell"><section class="login-card"><div class="brand">FF<span>Billing</span></div><p class="muted">Masuk ke panel pengelolaan ISP</p><% if(error){ %><div class="alert"><%= error %></div><% } %><form method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Username<input name="username" autocomplete="username" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="primary full">Masuk</button></form></section></main>
<% }else{ %>
<aside class="sidebar"><div class="brand">FF<span>Billing</span></div><nav><a href="/">Dashboard</a><a href="/customers">Pelanggan</a><a href="/packages">Paket internet</a><a href="/subscriptions">Langganan</a><a href="/invoices">Tagihan</a><a href="/genieacs">GenieACS</a></nav><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout">Keluar</button></form></aside>
<main class="main"><header class="topbar"><span>Internet Service Management</span><strong><%= currentUser?currentUser.username:'' %></strong></header>
<% if(page==='dashboard'){ %>
<div class="page-head"><div><p class="eyebrow">OVERVIEW</p><h1>Dashboard</h1><p class="muted">Ringkasan operasional billing ISP.</p></div></div>
<div class="stats"><article><span>Pelanggan aktif</span><strong><%= metrics.customers %></strong></article><article><span>Tagihan terbuka</span><strong><%= metrics.unpaid %></strong></article><article><span>Sisa tagihan</span><strong><%= fmt(metrics.due) %></strong></article><article><span>Pembayaran bulan ini</span><strong><%= fmt(metrics.collected) %></strong></article></div>
<section class="panel"><h2>Mulai kelola billing</h2><p class="muted">Tambahkan paket, daftarkan pelanggan, pasang langganan, lalu generate invoice.</p><div class="actions"><a class="primary" href="/customers/new">Tambah pelanggan</a><a class="secondary" href="/packages">Kelola paket</a><a class="secondary" href="/subscriptions/new">Buat langganan</a><a class="secondary" href="/invoices">Lihat tagihan</a></div></section>
<% }else if(page==='customers'){ %>
<div class="page-head"><div><p class="eyebrow">CUSTOMER MANAGEMENT</p><h1>Pelanggan</h1></div><a class="primary" href="/customers/new">+ Pelanggan</a></div><section class="panel table-wrap"><table><thead><tr><th>Kode</th><th>Nama</th><th>Telepon</th><th>Status</th><th>PPPoE</th><th></th></tr></thead><tbody><% customers.forEach(c=>{ %><tr><td><strong><%= c.customer_code %></strong></td><td><%= c.name %></td><td><%= c.phone %></td><td><span class="status"><%= c.status %></span></td><td><%= c.pppoe_username||'-' %></td><td><a href="/customers/<%= c.id %>/edit">Edit</a></td></tr><% }) %></tbody></table><% if(!customers.length){ %><p class="empty">Belum ada pelanggan.</p><% } %></section>
<% }else if(page==='customer-form'){ %>
<div class="page-head"><div><p class="eyebrow">CUSTOMER MANAGEMENT</p><h1><%= customer.id?'Edit pelanggan':'Tambah pelanggan' %></h1></div><a class="secondary" href="/customers">Kembali</a></div><section class="panel form-panel"><% if(error){ %><div class="alert"><%= error %></div><% } %><form method="post" action="<%= customer.id?'/customers/'+customer.id+'/update':'/customers' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><% [['customer_code','Kode pelanggan'],['name','Nama pelanggan'],['phone','Nomor telepon'],['email','Email'],['address','Alamat'],['pppoe_username','Username PPPoE'],['genieacs_device_id','GenieACS Device ID']].forEach(([k,l])=>{ %><label><%= l %><input name="<%= k %>" value="<%= val(customer,k) %>" <%= ['customer_code','name','phone'].includes(k)?'required':'' %>></label><% }) %><label>Status<select name="status"><% ['active','suspended','inactive'].forEach(s=>{ %><option value="<%= s %>" <%= (customer.status||'active')===s?'selected':'' %>><%= s %></option><% }) %></select></label></div><button class="primary">Simpan pelanggan</button></form></section>
<% }else if(page==='packages'){ %>
<div class="page-head"><div><p class="eyebrow">PRODUCT CATALOG</p><h1>Paket internet</h1></div></div><section class="panel"><h2>Tambah paket</h2><form class="form-grid compact" method="post" action="/packages"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nama paket<input name="name" required></label><label>Harga per bulan (Rp)<input type="number" min="0" name="price" required></label><label>Download Mbps<input type="number" min="0" name="speed_down" required></label><label>Upload Mbps<input type="number" min="0" name="speed_up" required></label><label>Harga promo (opsional)<input type="number" min="0" name="promo_price"></label><label>Siklus promo<input type="number" min="0" name="promo_cycles" value="0"></label><label class="wide">Deskripsi<input name="description"></label><button class="primary">Simpan paket</button></form></section><section class="panel table-wrap"><table><thead><tr><th>Nama</th><th>Kecepatan</th><th>Harga</th><th>Promo</th><th>Status</th><th></th></tr></thead><tbody><% packages.forEach(p=>{ %><tr><td><strong><%= p.name %></strong><small><%= p.description %></small></td><td><%= p.speed_down %>/<%= p.speed_up %> Mbps</td><td><%= fmt(p.price) %></td><td><%= p.promo_price===null?'-':fmt(p.promo_price) %></td><td><%= p.is_active?'Aktif':'Arsip' %></td><td><% if(p.is_active){ %><form method="post" action="/packages/<%= p.id %>/archive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button">Arsipkan</button></form><% } %></td></tr><% }) %></tbody></table><% if(!packages.length){ %><p class="empty">Belum ada paket.</p><% } %></section>
<% }else if(page==='subscriptions'){ %>
<div class="page-head"><div><p class="eyebrow">SERVICE MANAGEMENT</p><h1>Langganan</h1></div><a class="primary" href="/subscriptions/new">+ Langganan</a></div><section class="panel table-wrap"><table><thead><tr><th>Pelanggan</th><th>Paket</th><th>Harga</th><th>Mulai</th><th>Status</th><th></th></tr></thead><tbody><% subscriptions.forEach(s=>{ %><tr><td><strong><%= s.customer_name %></strong><small><%= s.customer_code %></small></td><td><%= s.package_name %></td><td><%= fmt(s.price) %></td><td><%= s.start_date %></td><td><span class="status"><%= s.status %></span></td><td><% if(s.status==='active'){ %><form method="post" action="/subscriptions/<%= s.id %>/end"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button">Akhiri</button></form><% } %></td></tr><% }) %></tbody></table><% if(!subscriptions.length){ %><p class="empty">Belum ada langganan.</p><% } %></section>
<% }else if(page==='subscription-form'){ %>
<div class="page-head"><div><p class="eyebrow">SERVICE MANAGEMENT</p><h1>Buat langganan</h1></div><a class="secondary" href="/subscriptions">Kembali</a></div><section class="panel form-panel"><form method="post" action="/subscriptions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><label>Pelanggan<select name="customer_id" required><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.customer_code %> · <%= c.name %></option><% }) %></select></label><label>Paket<select name="package_id" required><% packages.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %> · <%= fmt(p.price) %> · <%= p.speed_down %>/<%= p.speed_up %> Mbps</option><% }) %></select></label><label>Tanggal mulai<input type="date" name="start_date" value="<%= new Date().toISOString().slice(0,10) %>" required></label></div><button class="primary" <%= (!customers.length||!packages.length)?'disabled':'' %>>Simpan langganan</button><% if(!customers.length||!packages.length){ %><p class="muted">Tambahkan minimal satu pelanggan aktif dan satu paket aktif terlebih dahulu.</p><% } %></form></section>
<% }else if(page==='invoices'){ %>
<div class="page-head"><div><p class="eyebrow">BILLING & COLLECTION</p><h1>Tagihan</h1></div></div><section class="panel"><h2>Generate invoice bulanan</h2><form class="form-grid compact" method="post" action="/invoices/generate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Tahun<input type="number" name="year" value="<%= new Date().getFullYear() %>" required></label><label>Bulan<input type="number" name="month" min="1" max="12" value="<%= new Date().getMonth()+1 %>" required></label><label>Jatuh tempo<input type="date" name="due_date" required></label><button class="primary">Generate tagihan</button></form></section><section class="panel table-wrap"><table><thead><tr><th>Invoice</th><th>Pelanggan</th><th>Periode</th><th>Nominal</th><th>Dibayar</th><th>Status</th><th>Catat bayar</th></tr></thead><tbody><% invoices.forEach(i=>{ %><tr><td><strong><%= i.invoice_number %></strong></td><td><%= i.customer_name %><small><%= i.customer_code %></small></td><td><%= String(i.period_month).padStart(2,'0') %>/<%= i.period_year %></td><td><%= fmt(i.amount) %></td><td><%= fmt(i.amount_paid) %></td><td><span class="status"><%= i.status %></span></td><td><% if(['unpaid','partial','overdue'].includes(i.status)){ %><form method="post" action="/invoices/<%= i.id %>/payments" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="number" name="amount" min="1" max="<%= i.amount-i.amount_paid %>" placeholder="Nominal" required><select name="method"><option value="cash">Cash</option><option value="transfer">Transfer</option><option value="qris">QRIS</option><option value="other">Lainnya</option></select><button class="secondary">Bayar</button></form><% } %></td></tr><% }) %></tbody></table><% if(!invoices.length){ %><p class="empty">Belum ada invoice.</p><% } %></section>
<% }else if(page==='genieacs'){ %>
<div class="page-head"><div><p class="eyebrow">DEVICE MANAGEMENT</p><h1>GenieACS</h1><p class="muted">Koneksi REST GenieACS · mode baca saja</p></div></div><section class="panel"><% if(error){ %><div class="alert"><%= error %></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Device ID</th><th>Manufacturer</th><th>Model</th><th>Serial</th></tr></thead><tbody><% devices.forEach(d=>{const info=d._deviceId||{}; %><tr><td><%= d._id||'-' %></td><td><%= info._Manufacturer||'-' %></td><td><%= info._ProductClass||'-' %></td><td><%= info._SerialNumber||'-' %></td></tr><% }) %></tbody></table><% if(!devices.length){ %><p class="empty">Tidak ada perangkat ditemukan.</p><% } %></div><% } %></section>
<% }else{ %><section class="panel"><h1>Terjadi kesalahan</h1><p><%= message||'Halaman tidak ditemukan.' %></p><a class="primary" href="/">Kembali</a></section><% } %>
</main>
<% } %>
</body></html>
